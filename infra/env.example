# Model of /opt/gerio-lab/.env on the server. Fake values only.
# DB_PASSWORD is generated by remote.sh on the first deploy; the other lines are rewritten at each deploy.
DB_PASSWORD=change-me
PLATFORM_BASE_DOMAIN=lab.example.invalid
LAB_BASE_DOMAIN=lab.example.invalid
APP_IMAGE=ghcr.io/example/platform@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Mail (Brevo SMTP), all optional and absent by default (compose defaults: sending off, port 587).
# remote.sh adds a line only when the value is set. Shown commented out as a model.
# GERIO_MAIL_ENABLED=false
# GERIO_SMTP_HOST=smtp.example.invalid
# GERIO_SMTP_PORT=587
# GERIO_MAIL_FROM=ordini@lab.example.invalid
# GERIO_SMTP_USER and the SMTP secret are never in this model: they exist only in the server .env.
